NODE_ENV=production
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
CONFIG_PATH=/etc/val-protection/val-protection.json
DATABASE_DRIVER=sqlite
SQLITE_PATH=/var/lib/val-protection/val-protection.db
MIGRATE_ON_START=true
EVIDENCE_HMAC_KEY=
ALERT_FALLBACK_WEBHOOK_URL=
LOG_LEVEL=info
LOG_DIR=/var/log/val-protection
BACKUP_DIR=/var/backups/val-protection
BACKUP_KEEP=14
SHUTDOWN_TIMEOUT_MS=10000
