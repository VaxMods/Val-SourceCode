[Unit]
Description=Val Protection database backup and restore test
After=network-online.target

[Service]
Type=oneshot
User=valprotection
Group=valprotection
WorkingDirectory=/opt/val-protection
EnvironmentFile=/etc/val-protection/val-protection.env
ExecStart=/usr/bin/node /opt/val-protection/dist/cli/backup.js
ExecStartPost=/usr/bin/node /opt/val-protection/dist/cli/restoreTest.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/val-protection /var/backups/val-protection
